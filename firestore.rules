rules_version = '2';

// Règles de sécurité de la plateforme.
// Rôles (champ users/{uid}.role) : "company" (entreprise), "supplier" (fournisseur), "admin".
// Le premier administrateur est nommé depuis la console Firebase ; les suivants depuis l'onglet « Équipe » de l'admin.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fonctions ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(uid())); }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(uid())); }
    function role() { return userDoc().data.role; }
    function isAdmin() { return hasProfile() && role() == "admin"; }
    function isCompany() { return hasProfile() && role() == "company"; }
    function isSupplier() { return hasProfile() && role() == "supplier"; }
    function supplierStatus(id) { return get(/databases/$(database)/documents/suppliers/$(id)).data.status; }
    function isApprovedCompany() {
      return isCompany() && exists(/databases/$(database)/documents/companies/$(uid()))
        && get(/databases/$(database)/documents/companies/$(uid())).data.status == "approved";
    }
    function isApprovedSupplier() {
      return isSupplier() && exists(/databases/$(database)/documents/suppliers/$(uid())) && supplierStatus(uid()) == "approved";
    }

    function data() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function str(f, max) { return f is string && f.size() <= max; }
    function optStr(d, f, max) { return !(f in d) || d[f] == null || str(d[f], max); }
    function optNum(d, f) { return !(f in d) || d[f] == null || (d[f] is number && d[f] >= 0); }

    // Champs communs aux fiches entreprise et fournisseur
    function validOrg(d) {
      return str(d.name, 120) && d.name.size() > 0
        && optStr(d, "contactName", 80) && optStr(d, "phone", 30) && optStr(d, "email", 120)
        && optStr(d, "city", 60) && optStr(d, "country", 60) && optStr(d, "address", 160)
        && optStr(d, "description", 2000);
    }

    // ---------- Comptes ----------
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      allow create: if signedIn() && uid() == userId
        && data().role in ["company", "supplier"]
        && data().keys().hasOnly(["role", "email", "displayName", "createdAt"]);
      allow update: if (signedIn() && uid() == userId && !changed().hasAny(["role", "previousRole"]))
        // Un administrateur nomme ou retire les membres de l'équipe, mais ne peut pas se retirer lui-même
        || (isAdmin() && (uid() != userId || data().role == "admin"));
      allow delete: if isAdmin();
    }

    // ---------- Entreprises ----------
    match /companies/{companyId} {
      // Les coordonnées de l'entreprise sont visibles par les membres connectés (pour le suivi des offres acceptées)
      allow read: if hasProfile();
      // Comme les fournisseurs : inscription « en attente », validation par l'équipe
      allow create: if isCompany() && uid() == companyId && data().status == "pending"
        && validOrg(data()) && optStr(data(), "sector", 80);
      allow update: if (isCompany() && uid() == companyId && !changed().hasAny(["status"])
          && validOrg(data()) && optStr(data(), "sector", 80))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- Fournisseurs ----------
    match /suppliers/{supplierId} {
      // Fiche publique une fois validée par l'administrateur
      allow read: if resource.data.status == "approved" || (signedIn() && uid() == supplierId) || isAdmin();
      allow create: if isSupplier() && uid() == supplierId && data().status == "pending"
        && validOrg(data()) && data().categories is list && data().categories.size() <= 30 && optStr(data(), "website", 120);
      // Le fournisseur modifie sa fiche mais jamais son statut
      allow update: if (isSupplier() && uid() == supplierId && !changed().hasAny(["status"])
          && validOrg(data()) && data().categories is list && data().categories.size() <= 30 && optStr(data(), "website", 120))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- Produits & services ----------
    match /products/{productId} {
      // supplierApproved reflète le statut du fournisseur : l'admin le met à jour lors de la validation/suspension
      allow read: if resource.data.supplierApproved == true
        || (signedIn() && resource.data.supplierId == uid()) || isAdmin();
      allow create: if isSupplier() && data().supplierId == uid()
        && data().supplierApproved == (supplierStatus(uid()) == "approved")
        && validProduct(data());
      allow update: if (isSupplier() && resource.data.supplierId == uid() && data().supplierId == uid()
          && data().supplierApproved == (supplierStatus(uid()) == "approved")
          && validProduct(data()))
        || isAdmin();
      allow delete: if (isSupplier() && resource.data.supplierId == uid()) || isAdmin();

      function validProduct(d) {
        return str(d.name, 120) && d.name.size() > 0 && str(d.category, 80) && optStr(d, "description", 2000)
          && optNum(d, "price") && optStr(d, "currency", 10) && optStr(d, "unit", 30) && optStr(d, "minOrder", 60)
          && str(d.supplierName, 120);
      }
    }

    // ---------- Demandes de devis ----------
    match /rfqs/{rfqId} {
      allow read: if (signedIn() && resource.data.companyId == uid()) || isApprovedSupplier() || isAdmin();
      // Seules les entreprises validées publient (ou rouvrent) des demandes
      allow create: if isApprovedCompany() && data().companyId == uid() && data().status == "open" && validRfq(data());
      allow update: if (isCompany() && resource.data.companyId == uid()
          && (data().status != "open" || resource.data.status == "open" || isApprovedCompany())
          && !changed().hasAny(["companyId", "createdAt"])
          && data().status in ["open", "closed", "awarded"] && validRfq(data()))
        || isAdmin();
      allow delete: if (signedIn() && resource.data.companyId == uid()) || isAdmin();

      function validRfq(d) {
        return str(d.title, 140) && d.title.size() > 0 && str(d.category, 80) && str(d.description, 4000)
          && str(d.companyName, 120) && optStr(d, "city", 80) && optStr(d, "unit", 30) && optStr(d, "deadline", 10)
          && optStr(d, "currency", 10) && optNum(d, "quantity") && optNum(d, "budget");
      }
    }

    // ---------- Offres ----------
    // Identifiant imposé : {rfqId}_{supplierId} → une seule offre par fournisseur et par demande
    match /offers/{offerId} {
      function rfq(id) { return get(/databases/$(database)/documents/rfqs/$(id)).data; }

      allow read: if signedIn() && (resource.data.supplierId == uid() || resource.data.companyId == uid()) || isAdmin();

      allow create: if isApprovedSupplier()
        && offerId == data().rfqId + "_" + uid()
        && data().supplierId == uid()
        && data().status == "pending"
        && rfq(data().rfqId).status == "open"
        && data().companyId == rfq(data().rfqId).companyId
        && validOffer(data());

      allow update: if
        // Le fournisseur modifie son offre tant qu'elle est en attente et que la demande est ouverte
        (isApprovedSupplier() && resource.data.supplierId == uid() && resource.data.status == "pending"
          && rfq(resource.data.rfqId).status == "open"
          && changed().hasOnly(["price", "currency", "delay", "validity", "message", "updatedAt"]) && validOffer(data()))
        // L'entreprise accepte ou refuse
        || (isCompany() && resource.data.companyId == uid()
          && changed().hasOnly(["status", "updatedAt"]) && data().status in ["accepted", "rejected"])
        || isAdmin();

      allow delete: if (signedIn() && resource.data.supplierId == uid() && resource.data.status == "pending") || isAdmin();

      function validOffer(d) {
        return d.price is number && d.price >= 0 && optStr(d, "currency", 10) && str(d.delay, 60)
          && optStr(d, "validity", 60) && optStr(d, "message", 3000);
      }
    }

    // ---------- Messagerie entreprise ⇄ fournisseur ----------
    // Identifiant imposé : {entreprise}_{fournisseur} → une seule conversation par paire.
    // Seuls les deux participants lisent et écrivent ; l'administrateur supervise (lecture, suppression).
    match /conversations/{convId} {
      function companyOk(id) {
        return exists(/databases/$(database)/documents/companies/$(id))
          && get(/databases/$(database)/documents/companies/$(id)).data.status == "approved";
      }
      function supplierOk(id) {
        return exists(/databases/$(database)/documents/suppliers/$(id)) && supplierStatus(id) == "approved";
      }

      // resource == null : permet de vérifier si la conversation existe déjà (sans rien révéler d'autre)
      allow read: if signedIn() && (resource == null || uid() in resource.data.participants) || isAdmin();

      allow create: if signedIn()
        && convId == data().companyId + "_" + data().supplierId
        && data().participants == [data().companyId, data().supplierId]
        && ((uid() == data().companyId && isApprovedCompany() && supplierOk(data().supplierId))
          || (uid() == data().supplierId && isApprovedSupplier() && companyOk(data().companyId)))
        && str(data().companyName, 120) && str(data().supplierName, 120)
        && data().keys().hasOnly(["companyId", "supplierId", "participants", "companyName", "supplierName", "createdAt", "lastAt", "lastMessage", "lastSender", "readAt"]);

      // Un participant met à jour le dernier message (le sien) et sa propre date de lecture
      allow update: if signedIn() && uid() in resource.data.participants
        && changed().hasOnly(["lastMessage", "lastAt", "lastSender", "readAt"])
        && (!changed().hasAny(["lastMessage"]) || (data().lastSender == uid() && str(data().lastMessage, 200)))
        && (!changed().hasAny(["readAt"]) || data().readAt.diff(resource.data.get("readAt", {})).affectedKeys().hasOnly([uid()]));

      allow delete: if isAdmin();

      match /messages/{msgId} {
        function conv() { return get(/databases/$(database)/documents/conversations/$(convId)).data; }
        allow read: if signedIn() && uid() in conv().participants || isAdmin();
        allow create: if signedIn() && uid() in conv().participants
          && data().senderId == uid()
          && str(data().text, 2000) && data().text.size() > 0
          && data().keys().hasOnly(["senderId", "senderName", "text", "createdAt"]);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ---------- Paramètres (catégories) ----------
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
